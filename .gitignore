# Virtual environment
.venv/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Environment variables / secrets
.env
.env.local

# macOS junk
.DS_Store

# IDE / editor
.vscode/
.idea/
*.swp

# Logs
*.log

# Build artifacts
build/
dist/
*.egg-info/

# Project-specific: generated output
output/

# Project-specific: ML model weights (downloaded by huggingface_hub at runtime,
# stored under ~/.kindle_converter/models/ — NOT inside the repo). Do NOT ignore
# kindle_math_converter/models/: that directory is source code (document.py,
# enums.py, results.py), not weights.
*.pt
*.pth
*.onnx
*.safetensors

# Project-specific: equation render cache (runtime data only). Do NOT ignore
# kindle_math_converter/cache/: that directory is source code (equation_cache.py).
.cache/

# Project-specific: test PDFs (large, not source)
*.pdf
!docs/*.pdf

# Backup files
*.pre-update
*.bak
